# PostHog (analytics, session replay, heatmap). Copia questo file in .env.local
# (ignorato da git) e inserisci i valori del progetto PostHog:
# Project settings > Project API key / Host.
# Senza chiave PostHog non viene caricato.
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_POSTHOG_HOST=https://eu.i.posthog.com
